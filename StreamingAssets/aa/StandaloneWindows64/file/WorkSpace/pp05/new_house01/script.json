    "lines": [
      "ホアキン",
      "えーっと──",
      "あの──",
      "パパ？",
      "ジャン",
      "なんだ、ホアキン？",
      "ホアキン",
      "へへっ──",
      "ジャン",
      "どうした？",
      "ホアキン",
      "本当に僕のパパになったんだね！",
      "ジャン",
      "──",
      "シャロン",
      "どうしたの？",
      "ジャン",
      "──いや",
      "──俺は自分を感情の希薄な人間だと",
      "思っていたが──",
      "ジャン",
      "自分には",
      "心がないフリをしていたのかもしれない。",
      "シャロン",
      "違うわ。",
      "貴方も、死んだ主人も",
      "優し過ぎる心ゆえに傷つくの。",
      "シャロン",
      "この世があまりに、辛いことに",
      "満ちているから。",
      "ジャン",
      "届いたようだな。",
      "シャロン",
      "何が？",
      "ジャン",
      "しっ、ホアキンには内緒だ。",
      "宅配業者",
      "ザウアーさん",
      "ネクサス社からお届け物です。",
      "シャロン",
      "ありがとう。",
      "宅配業者",
      "それじゃあ、確かに。",
      "シャロン",
      "中身はなあに──？",
      "ジャン",
      "ホアキン──",
      "向こうに行って包みを開けてみるといい。",
      "ホアキン",
      "僕が？",
      "いったい、なんだろう？"
    ],
